<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
  <div class="page-header">
    <h2><i class="fas fa-user-md"></i> Doctors</h2>
    <a href="/doctors/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Doctor</a>
  </div>
  <div class="card">
    <table class="table">
      <thead>
        <tr><th>Name</th><th>Specialization</th><th>Phone</th><th>Experience</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% doctors.forEach(d => { %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.specialization %></td>
          <td><%= d.phone %></td>
          <td><%= d.experience ? d.experience + ' yrs' : 'N/A' %></td>
          <td><span class="badge badge-<%= d.availability === 'Available' ? 'scheduled' : 'cancelled' %>"><%= d.availability %></span></td>
          <td>
            <a href="/doctors/edit/<%= d._id %>" class="btn btn-sm btn-secondary">Edit</a>
            <form action="/doctors/delete/<%= d._id %>" method="POST" style="display:inline">
              <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this doctor?')">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (!doctors.length) { %>
        <tr><td colspan="6" style="text-align:center; color:#888;">No doctors found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
